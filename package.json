{
  "name": "audio-limiter",
  "version": "0.1.0",
  "description": "Modern AudioWorklet limiter with explicit factory API",
  "keywords": [
    "audio",
    "limiter",
    "web-audio",
    "worklet"
  ],
  "license": "MIT",
  "author": "bjesuiter@gmail.com",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "type-check": "tsc --noEmit",
    "build": "tsdown",
    "lint": "oxlint src test tsdown.config.ts vitest.config.ts",
    "format": "oxfmt src test tsdown.config.ts vitest.config.ts AGENTS.md README.md package.json",
    "format:check": "oxfmt --check src test tsdown.config.ts vitest.config.ts AGENTS.md README.md package.json",
    "test": "vitest run",
    "test:browser": "vitest run --browser",
    "prepack": "bun run clean && bun run format:check && bun run lint && bun run type-check && bun run test:browser && bun run build"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "playwright": "^1.59.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
