{
  "name": "audio-limiter",
  "version": "0.1.0",
  "description": "Modern AudioWorklet limiter with explicit factory API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "type-check": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "test:browser": "vitest run --browser",
    "prepack": "npm run clean && npm run type-check && npm run build"
  },
  "keywords": [
    "audio",
    "limiter",
    "worklet",
    "web-audio"
  ],
  "author": "robert.kami88@gmail.com",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "playwright": "^1.59.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
